{
  "description": "anki-v2 build guardrails. Edited only by the owner. Trust them once with /hooks in the Codex CLI.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "NONBLOCKING=1 bash \"$(git rev-parse --show-toplevel)/.codex/hooks/run.sh\" inject_invariants.py",
            "statusMessage": "Loading build invariants",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "apply_patch|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/run.sh\" freeze_contract.py",
            "statusMessage": "Checking contract freeze",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/run.sh\" no_network.py pre",
            "statusMessage": "Checking for network imports",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/run.sh\" no_network.py post",
            "statusMessage": "Sweeping edited files for network imports",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
